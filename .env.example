# ============================================================
# Gamervoult & IMAP Proxy Backend Server Environment Configuration
# Place all production environment variables securely in Render/Vercel settings.
# ============================================================

# Server Port
PORT=8080
NODE_ENV=production

# ------------------------------------------------------------
# Firebase Admin Credentials (Raw JSON String or Service Account file)
# ------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id",...}
# Alternatively: GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ------------------------------------------------------------
# API Authorization & Legacy Secret Keys
# ------------------------------------------------------------
CUSTOMER_API_KEY=your_secure_customer_api_key_here
ADMIN_API_KEY=your_secure_admin_api_key_here
API_SECRET_KEY=your_secure_otp_service_secret_here

# ------------------------------------------------------------
# Distributed Rate Limiting (Upstash Redis)
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ------------------------------------------------------------
# CORS & Allowed Origins
# ------------------------------------------------------------
ALLOWED_ORIGINS=https://freefireofficial.in,https://ff-store-4a61e.web.app,https://ff-store-4a61e.firebaseapp.com

# ------------------------------------------------------------
# Telegram Bot & Webhook Security
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# ------------------------------------------------------------
# Google & Zoho OAuth API Credentials (IMAP/Gmail Integration)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here

# ------------------------------------------------------------
# Cloudinary Backend Signing Credentials (Protected Uploads)
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------
# UPI Payment Gateway Integration (Server-to-Server)
# ------------------------------------------------------------
UPI_GATEWAY_URL=https://your-payment-gateway.onrender.com
UPI_GATEWAY_API_KEY=your_private_gateway_api_key
UPI_WEBHOOK_SECRET=your_webhook_signature_secret

# ------------------------------------------------------------
# Gemini AI API Configuration (Backend AI Copilot)
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
